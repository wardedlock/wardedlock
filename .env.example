# ==============================================================================
# WARDEDLOCK ENVIRONMENT TEMPLATE
# ==============================================================================

# 1. DEPLOYMENT & GLOBAL
# ------------------------------------------------------------------------------
ENV=dev
TZ=UTC
LOG_LEVEL=DEBUG
METRICS_PORT=9090

# 2. PORT & HOST MAPPING
# ------------------------------------------------------------------------------
GATEWAY_SERVICE_PORT=18080
AUTH_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
ROLE_SERVICE_PORT=8083
APP_MANAGEMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# 3. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=dev_password_postgres

AUTH_DB=wardedlock_auth
AUTH_USER=auth_user
AUTH_PASSWORD=dev_password_auth

ACCOUNT_DB=wardedlock_account
ACCOUNT_USER=account_user
ACCOUNT_PASSWORD=dev_password_account

ROLE_DB=wardedlock_role
ROLE_USER=role_user
ROLE_PASSWORD=dev_password_role

APP_MANAGEMENT_DB=wardedlock_app
APP_MANAGEMENT_USER=app_user
APP_MANAGEMENT_PASSWORD=dev_password_app

NOTIFICATION_DB=wardedlock_notification
NOTIFICATION_USER=notification_user
NOTIFICATION_PASSWORD=dev_password_notification

# 4. REDIS (Cache & Message Broker)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_password_redis

# 5. SECURITY & JWT TOKEN
# ------------------------------------------------------------------------------
JWT_ISSUER=wardedlock.local
JWT_PRIVATE_KEY_PATH=./secrets/jwt_rs256.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_rs256.pub
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=2592000s
JWT_KEY_ROTATION_DAYS=90

# 6. MFA & SECURITY SETTINGS
# ------------------------------------------------------------------------------
MFA_TOTP_ISSUER=Wardedlock

# 7. WEBHOOK
# ------------------------------------------------------------------------------
WEBHOOK_HMAC_KEY_PATH=./secrets/webhook_hmac.key

# 8. SMTP (MailPit / Production SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_FROM=no-reply@wardedlock.local

# 9. S3 / MINIO (Storage)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=wardedlock_dev_minio
S3_BUCKET_BACKUP=wardedlock-backup
S3_BUCKET_EXPORT=wardedlock-export
S3_BUCKET_AVATAR=wardedlock-avatar

# 10. RATE LIMITING
# ------------------------------------------------------------------------------
RATELIMIT_DEFAULT_RPS=60
RATELIMIT_DEFAULT_BURST=100

# 11. SMS PROVIDER (Twilio) — required when FR-NOTI-002 is implemented
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# 12. OBSERVABILITY (post-1.0.0) — NFR-MAIN-005
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# 13. CORS — Gateway
# CORS_ALLOWED_ORIGINS=http://localhost:3000
